---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/ContactPage.astro';
---
<BaseLayout>
  <main id="conteudo">
    <section class="hero" aria-labelledby="hero-title">
      <span class="decoration-circle" aria-hidden="true"></span>
      <span class="decoration-diamond" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__copy">
          <a class="wordmark" href="#conteudo" aria-label="VemMED, início">
            <img src="/assets/logo-vemmed.svg" alt="VemMED" />
          </a>
          <p class="page-badge">5 MAIS ACERTADAS E 5 MAIS ERRADAS DO ENEM 2025</p>
          <h1 id="hero-title">As 5 questões mais acertadas e as 5 mais erradas do ENEM 2025.</h1>
          <p class="hero__lead">Conheça as 5 questões mais acertadas e as 5 mais erradas do ENEM 2025 e experimente resolvê-las. Uma oportunidade para observar como você lida com diferentes questões e reconhecer o que merece atenção na sua revisão.</p>
          <div class="hero__access" role="note" aria-label="Acesso gratuito">
            <span class="hero__access-check" aria-hidden="true">✓</span>
            <div>
              <p class="hero__access-title">Acesso gratuito.</p>
              <p class="hero__access-description">Solicite a liberação pelo formulário.</p>
            </div>
          </div>
        </div>
        <aside class="capture-panel" id="cadastro" aria-labelledby="panel-title">
          <p class="capture-panel__eyebrow">ACESSO AO APLICATIVO</p>
          <p class="capture-panel__description" id="panel-title">Solicite acesso ao guia e prepare sua próxima revisão para o ENEM.</p>
          <ContactPage />
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
